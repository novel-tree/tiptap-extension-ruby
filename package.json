{
  "name": "tiptap-extension-ruby",
  "version": "0.1.0",
  "description": "A TipTap v3 extension that adds Ruby (furigana) annotations for CJK text.",
  "keywords": [
    "tiptap",
    "tiptap-extension",
    "prosemirror",
    "ruby",
    "furigana",
    "cjk",
    "japanese"
  ],
  "author": "Michael Kenji Wilkins",
  "license": "MIT",
  "homepage": "https://github.com/novel-tree/tiptap-extension-ruby#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novel-tree/tiptap-extension-ruby.git"
  },
  "bugs": {
    "url": "https://github.com/novel-tree/tiptap-extension-ruby/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "prepublishOnly": "pnpm build"
  },
  "prepare": "npm run build",
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/html": "^8.6.18",
    "@storybook/html-vite": "^8.6.18",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-document": "^3.0.0",
    "@tiptap/extension-paragraph": "^3.0.0",
    "@tiptap/extension-text": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.5.0",
    "happy-dom": "^15.11.7",
    "http-server": "^14.1.1",
    "prettier": "^3.4.2",
    "storybook": "^8.6.18",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0"
}
